<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>StudyFlow Authentication</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {

            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            background:
                linear-gradient(-45deg,
                    #0f172a,
                    #164e63,
                    #0f766e,
                    #0f172a);

            background-size: 400% 400%;

            animation: gradientMove 12s ease infinite;
        }

        @keyframes gradientMove {

            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        .auth-container {

            width: 900px;

            display: grid;
            grid-template-columns: 1fr 1fr;

            gap: 30px;

            padding: 40px;

            border-radius: 25px;

            background:
                rgba(255, 255, 255, 0.06);

            backdrop-filter: blur(18px);

            border:
                1px solid rgba(255, 255, 255, 0.12);

            box-shadow:
                0 0 40px rgba(0, 0, 0, 0.4);
        }

        .panel {

            padding: 30px;

            border-radius: 20px;

            background:
                rgba(255, 255, 255, 0.04);

            border:
                1px solid rgba(255, 255, 255, 0.08);
        }

        .logo {

            text-align: center;

            margin-bottom: 30px;
        }

        .logo h1 {

            color: white;

            font-size: 2.2rem;
        }

        .logo p {

            color: #94a3b8;

            margin-top: 8px;
        }

        .panel h2 {

            color: white;

            margin-bottom: 20px;
        }

        input {

            width: 100%;

            padding: 14px;

            margin-bottom: 15px;

            border: none;

            outline: none;

            border-radius: 12px;

            background:
                rgba(255, 255, 255, 0.08);

            color: white;
        }

        input::placeholder {

            color: #cbd5e1;
        }

        button {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 12px;

            cursor: pointer;

            font-weight: 600;

            font-size: 15px;

            transition: 0.3s;
        }

        .register-btn {

            background: #06b6d4;

            color: white;
        }

        .register-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 0 20px rgba(6, 182, 212, 0.6);
        }

        .login-btn {

            background: #8b5cf6;

            color: white;
        }

        .login-btn:hover {

            transform: translateY(-2px);

            box-shadow:
                0 0 20px rgba(139, 92, 246, 0.6);
        }

        .divider {

            width: 100%;
            height: 1px;

            background:
                rgba(255, 255, 255, 0.08);

            margin: 20px 0;
        }
        .error-message{

    margin-top: 12px;
    padding: 12px;

    background: rgba(127, 29, 29, 0.8);

    border: 1px solid rgba(239, 68, 68, 0.7);

    border-radius: 10px;

    color: #fecaca;

    font-weight: 600;

    text-align: center;

    box-shadow:
    0 0 15px rgba(239,68,68,0.4),
    inset 0 0 10px rgba(239,68,68,0.15);

    animation: errorGlow 2s infinite alternate;
}
@keyframes errorGlow {

    from {

        box-shadow:
        0 0 10px rgba(239,68,68,0.3),
        inset 0 0 10px rgba(239,68,68,0.1);
    }

    to {

        box-shadow:
        0 0 20px rgba(239,68,68,0.7),
        inset 0 0 15px rgba(239,68,68,0.2);
    }
}
.success-message{

    margin-top: 12px;
    padding: 12px;

    background: rgba(6, 78, 59, 0.8);

    border: 1px solid rgba(16,185,129,0.7);

    border-radius: 10px;

    color: #a7f3d0;

    font-weight: 600;

    text-align: center;

    box-shadow:
    0 0 15px rgba(16,185,129,0.4);

    animation: successGlow 2s infinite alternate;
}

@keyframes successGlow {

    from {
        box-shadow: 0 0 10px rgba(16,185,129,0.3);
    }

    to {
        box-shadow: 0 0 20px rgba(16,185,129,0.7);
    }
}
    </style>

</head>

<body>

    <div class="auth-container">

        
        <div class="panel">

            <div class="logo">

                <h1>📚 StudyFlow</h1>

                <p>Create Your Account</p>

            </div>

            <form action="/register" method="POST">

                <input type="text" name="name" placeholder="Full Name" required>

                <input type="email" name="email" placeholder="Email Address" required>

                <input type="password" name="password" placeholder="Password" required>
                <% if(registerError){ %>
                
                    <div class="error-message">
                
                        <%= registerError %>
                
                    </div>
                
                    <% } %>

                <button class="register-btn" type="submit">

                    Register 🚀

                </button>

            </form>

        </div>

        <div class="panel">

            <div class="logo">

                <h1>🔐 Welcome Back</h1>

                <p>Login To Continue</p>

            </div>

            <form action="/login" method="POST">

                <input type="email" name="email" placeholder="Email Address" required>

                <input type="password" name="password" placeholder="Password" required>
                <% if(loginError){ %>
                
                    <div class="error-message">
                
                        <%= loginError %>
                
                    </div>
                
                    <% } %>

                <button class="login-btn" type="submit">

                    Login ⚡

                </button>

            </form>

        </div>
        

    </div>

</body>

</html>